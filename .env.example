# Configuración de Firebase
FIREBASE_PROJECT_ID=conectionwdb
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/tu/credentials.json

# Configuración del servidor
PORT=8080

# Configuración de Firestore
FIRESTORE_COLLECTION=characters

# Autenticación — requerida para POST, PUT y DELETE
# Generar con: openssl rand -hex 32
API_KEY=cambia-esto-por-una-clave-secreta-segura
