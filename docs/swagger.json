{
    "swagger": "2.0",
    "info": {
        "description": "API REST para gestionar personajes e islas del mundo de One Piece. Proyecto de estudio con Clean Architecture en Go + Firestore.",
        "title": "One Piece API",
        "contact": {
            "name": "William Luna"
        },
        "license": {
            "name": "MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/characters": {
            "get": {
                "description": "Retorna todos los personajes almacenados en Firestore",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "characters"
                ],
                "summary": "Listar personajes",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/controller.SuccessResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/domain.Character"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Crea un nuevo personaje con UUID autogenerado",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "characters"
                ],
                "summary": "Crear personaje",
                "parameters": [
                    {
                        "description": "Datos del personaje",
                        "name": "character",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.Character"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/controller.SuccessResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/domain.Character"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/characters/devil-fruits": {
            "get": {
                "description": "Retorna solo los personajes que poseen una Fruta del Diablo",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "characters"
                ],
                "summary": "Personajes con Fruta del Diablo",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/controller.SuccessResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/domain.Character"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/characters/search": {
            "get": {
                "description": "Búsqueda por prefix en Firestore (case-sensitive). Ej: \"Monkey\" encuentra \"Monkey D. Luffy\"",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "characters"
                ],
                "summary": "Buscar personajes por nombre",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Prefijo del nombre a buscar",
                        "name": "name",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/controller.SuccessResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/domain.Character"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/characters/{id}": {
            "get": {
                "description": "Retorna un personaje específico dado su UUID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "characters"
                ],
                "summary": "Obtener personaje por ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID del personaje",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/controller.SuccessResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/domain.Character"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            },
            "put": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Actualiza un personaje existente por ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "characters"
                ],
                "summary": "Actualizar personaje",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID del personaje",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Datos actualizados",
                        "name": "character",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.Character"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/controller.SuccessResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/domain.Character"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Elimina un personaje y todos sus datos normalizados",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "characters"
                ],
                "summary": "Eliminar personaje",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID del personaje",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.SuccessResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/islands": {
            "get": {
                "description": "Retorna las 30 islas canónicas del mundo de One Piece con coordenadas 2D",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "islands"
                ],
                "summary": "Listar todas las islas",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Island"
                            }
                        }
                    }
                }
            }
        },
        "/api/islands/nearest": {
            "get": {
                "description": "Dado un punto (x,y) del mapa, retorna la isla más cercana usando un índice Quadtree 2D. Coordenadas: X 0-10000 (Oeste→Este), Y 0-5000 (Sur→Norte). La Grand Line corre en Y≈2500.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "islands"
                ],
                "summary": "Isla más cercana (Quadtree)",
                "parameters": [
                    {
                        "type": "number",
                        "example": 4300,
                        "description": "Coordenada X del mapa (0-10000)",
                        "name": "x",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "example": 2500,
                        "description": "Coordenada Y del mapa (0-5000)",
                        "name": "y",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Island"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/islands/region/{region}": {
            "get": {
                "description": "Filtra islas por región (East Blue, Grand Line, New World, Sky Islands, Red Line)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "islands"
                ],
                "summary": "Islas por región",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Nombre de la región",
                        "name": "region",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Island"
                            }
                        }
                    }
                }
            }
        },
        "/api/islands/{id}": {
            "get": {
                "description": "Retorna el detalle de una isla dado su slug (ej: water-7, laugh-tale)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "islands"
                ],
                "summary": "Obtener isla por ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Slug de la isla (ej: water-7)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Island"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controller.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "controller.SuccessResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "domain.Ability": {
            "type": "object",
            "properties": {
                "notes": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "domain.Character": {
            "type": "object",
            "properties": {
                "abilities": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.Ability"
                    }
                },
                "alias": {
                    "type": "string"
                },
                "devilFruit": {
                    "$ref": "#/definitions/domain.DevilFruit"
                },
                "firstAppearance": {
                    "type": "string"
                },
                "hakiAbilities": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.HakiAbility"
                    }
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "notes": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                },
                "species": {
                    "type": "string"
                }
            }
        },
        "domain.DevilFruit": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "domain.HakiAbility": {
            "type": "object",
            "properties": {
                "awakened": {
                    "type": "boolean"
                },
                "hakiType": {
                    "type": "string"
                },
                "notes": {
                    "type": "string"
                },
                "proficiency": {
                    "type": "string"
                }
            }
        },
        "domain.Island": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "notable_characters": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "region": {
                    "type": "string"
                },
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "Requerido para POST, PUT y DELETE. Configura la variable de entorno API_KEY en el servidor.",
            "type": "apiKey",
            "name": "X-API-Key",
            "in": "header"
        }
    }
}