{
  "info": {
    "name": "One Piece API",
    "description": "API REST para personajes de One Piece",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Characters",
      "item": [
        {
          "name": "Get All Characters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/characters",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "characters"]
            }
          }
        },
        {
          "name": "Get Character By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/characters/luffy",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "characters", "luffy"]
            }
          }
        },
        {
          "name": "Search Characters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/characters/search?name=luffy",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "characters", "search"],
              "query": [
                {
                  "key": "name",
                  "value": "luffy"
                }
              ]
            }
          }
        },
        {
          "name": "Get Characters With Devil Fruit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/characters/devil-fruits",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "characters", "devil-fruits"]
            }
          }
        },
        {
