{
  "info": {
    "name": "One Piece API",
    "_postman_id": "onepiece-api-collection-v2",
    "description": "Colección completa de la One Piece API. Usa la variable {{BASE_URL}} para el host y {{CHARACTER_ID}} para el ID activo.\n\n**Setup:**\n1. Configura el environment con BASE_URL=http://localhost:8080\n2. Corre 'GET All Characters' primero para ver los IDs disponibles\n3. Copia el ID que quieras en la variable CHARACTER_ID\n4. En producción configura también API_KEY para operaciones de escritura",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:8080" },
    {
      "key": "CHARACTER_ID",
      "value": "f6a7ee99-e589-4e3c-8a95-8dba0c0765e2",
      "description": "Monkey D. Luffy — cámbialo al ID que necesites"
    },
    {
      "key": "API_KEY",
      "value": "",
      "description": "Requerido para POST/PUT/DELETE — configura en tu environment"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/health"
          }
        }
      ]
    },
    {
      "name": "Characters",
      "item": [
        {
          "name": "GET All Characters",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/characters",
            "description": "Lista todos los personajes. Copia un ID de la respuesta y ponlo en la variable CHARACTER_ID."
          }
        },
        {
          "name": "GET Character by ID",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/characters/{{CHARACTER_ID}}"
          }
        },
        {
          "name": "GET Search by Name",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/characters/search?name=Luffy",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "characters", "search"],
              "query": [{ "key": "name", "value": "Luffy" }]
            }
          }
        },
        {
          "name": "GET Characters with Devil Fruit",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/characters/devil-fruits"
          }
        },
        {
          "name": "POST Create Character",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/characters",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{API_KEY}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nico Robin\",\n  \"origin\": \"Ohara\",\n  \"age\": 30,\n  \"bounty\": 130000000,\n  \"role\": \"Arqueóloga\",\n  \"crew\": \"Straw Hat Pirates\",\n  \"status\": \"Alive\",\n  \"devilFruit\": {\n    \"name\": \"Hana Hana no Mi\",\n    \"type\": \"Paramecia\",\n    \"description\": \"Permite florecer copias de partes del cuerpo en cualquier superficie\"\n  },\n  \"hakiAbilities\": [\n    { \"type\": \"Armament\", \"level\": \"Advanced\" }\n  ],\n  \"abilities\": [\n    { \"name\": \"Cien Fleur: Wing\", \"description\": \"Florece 100 brazos para volar\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "PUT Update Character",
          "request": {
            "method": "PUT",
            "url": "{{BASE_URL}}/api/characters/{{CHARACTER_ID}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{API_KEY}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monkey D. Luffy\",\n  \"origin\": \"East Blue\",\n  \"age\": 19,\n  \"bounty\": 3000000000,\n  \"role\": \"Capitán\",\n  \"crew\": \"Straw Hat Pirates\",\n  \"status\": \"Alive\",\n  \"devilFruit\": {\n    \"name\": \"Hito Hito no Mi, Model: Nika\",\n    \"type\": \"Mythical Zoan\",\n    \"description\": \"El poder más poderoso del mundo — transforma al usuario en el Sol God Nika\"\n  },\n  \"hakiAbilities\": [\n    { \"type\": \"Observation\", \"level\": \"Advanced\" },\n    { \"type\": \"Armament\", \"level\": \"Advanced\" },\n    { \"type\": \"Conqueror\", \"level\": \"Advanced\" }\n  ],\n  \"abilities\": [\n    { \"name\": \"Gear 5\", \"description\": \"Forma final desbloqueada con el poder de Nika\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "DELETE Character",
          "request": {
            "method": "DELETE",
            "url": "{{BASE_URL}}/api/characters/{{CHARACTER_ID}}",
            "header": [{ "key": "X-API-Key", "value": "{{API_KEY}}" }]
          }
        }
      ]
    },
    {
      "name": "Islands (Quadtree)",
      "item": [
        {
          "name": "GET All Islands",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/islands",
            "description": "Retorna las 30 islas del mundo de One Piece con coordenadas X/Y"
          }
        },
        {
          "name": "GET Island by ID",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/islands/dawn-island",
            "description": "Cambia 'dawn-island' por cualquier ID de isla de la lista"
          }
        },
        {
          "name": "GET Nearest Island (Quadtree)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/islands/nearest?x=1000&y=2600",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "islands", "nearest"],
              "query": [
                {
                  "key": "x",
                  "value": "1000",
                  "description": "Longitud (0-10000)"
                },
                {
                  "key": "y",
                  "value": "2600",
                  "description": "Latitud (0-5000)"
                }
              ]
            },
            "description": "Usa el Quadtree para encontrar la isla más cercana en O(log n). Cambia x e y a cualquier coordenada."
          }
        },
        {
          "name": "GET Islands by Region — East Blue",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/islands/region/East Blue"
          }
        },
        {
          "name": "GET Islands by Region — Grand Line",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/islands/region/Grand Line"
          }
        },
        {
          "name": "GET Islands by Region — New World",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/islands/region/New World"
          }
        }
      ]
    },
    {
      "name": "Routes (Dijkstra)",
      "item": [
        {
          "name": "GET All Routes",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/routes",
            "description": "Lista todas las rutas marítimas registradas."
          }
        },
        {
          "name": "GET Routes From Island",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/routes/from/dawn-island",
            "description": "Rutas donde la isla aparece como origen o destino."
          }
        },
        {
          "name": "GET Shortest Path — Fastest (default)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/routes/shortest?from=windmill-village&to=wano",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "routes", "shortest"],
              "query": [
                { "key": "from", "value": "windmill-village" },
                { "key": "to", "value": "wano" }
              ]
            },
            "description": "Dijkstra clásico: minimiza la suma de distancias. Sin parámetro 'mode' equivale a mode=fastest."
          }
        },
        {
          "name": "GET Shortest Path — Mode: fastest",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/routes/shortest?from=windmill-village&to=wano&mode=fastest",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "routes", "shortest"],
              "query": [
                { "key": "from", "value": "windmill-village" },
                { "key": "to", "value": "wano" },
                {
                  "key": "mode",
                  "value": "fastest",
                  "description": "Suma de Distance"
                }
              ]
            }
          }
        },
        {
          "name": "GET Shortest Path — Mode: safest",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/routes/shortest?from=windmill-village&to=wano&mode=safest",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "routes", "shortest"],
              "query": [
                { "key": "from", "value": "windmill-village" },
                { "key": "to", "value": "wano" },
                {
                  "key": "mode",
                  "value": "safest",
                  "description": "Minimax: minimiza el peor tramo (Danger)"
                }
              ]
            },
            "description": "totalCost = peligro del peor tramo del camino (1-5)."
          }
        },
        {
          "name": "GET Shortest Path — Mode: riskiest",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/routes/shortest?from=windmill-village&to=wano&mode=riskiest",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "routes", "shortest"],
              "query": [
                { "key": "from", "value": "windmill-village" },
                { "key": "to", "value": "wano" },
                {
                  "key": "mode",
                  "value": "riskiest",
                  "description": "Maximin: maximiza el mejor tramo (Danger)"
                }
              ]
            },
            "description": "totalCost = peligro del mejor tramo del camino (1-5)."
          }
        },
        {
          "name": "GET Shortest Path — Mode: quickest",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/routes/shortest?from=windmill-village&to=wano&mode=quickest",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "routes", "shortest"],
              "query": [
                { "key": "from", "value": "windmill-village" },
                { "key": "to", "value": "wano" },
                {
                  "key": "mode",
                  "value": "quickest",
                  "description": "Minimiza el tiempo total (TravelHours + LogPoseHours intermedios)"
                }
              ]
            },
            "description": "totalCost = totalTime (horas). Útil para comparar contra fastest: rutas largas en distancia pero con LogPose bajo pueden ser más rápidas."
          }
        },
        {
          "name": "GET Shortest Path — Invalid mode (400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/routes/shortest?from=windmill-village&to=wano&mode=foo",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "routes", "shortest"],
              "query": [
                { "key": "from", "value": "windmill-village" },
                { "key": "to", "value": "wano" },
                { "key": "mode", "value": "foo" }
              ]
            },
            "description": "Modo inválido debe responder 400."
          }
        },
        {
          "name": "GET Reachable Islands",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/routes/reachable?from=windmill-village&maxCost=2000",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "routes", "reachable"],
              "query": [
                { "key": "from", "value": "windmill-village" },
                { "key": "maxCost", "value": "2000" }
              ]
            },
            "description": "Islas alcanzables desde un origen con costo acumulado ≤ maxCost. Usa siempre Distance (modo fastest)."
          }
        },
        {
          "name": "GET Graph Stats (v3)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/routes/stats",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "routes", "stats"]
            },
            "description": "Métricas estructurales del grafo: totales, componentes conexos, distribución de Danger y promedios. Cacheado 60s."
          }
        }
      ]
    },
    {
      "name": "Swagger Docs",
      "item": [
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/docs/index.html",
            "description": "Abre en el browser para usar la interfaz interactiva"
          }
        },
        {
          "name": "OpenAPI JSON Spec",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/docs/doc.json"
          }
        }
      ]
    }
  ]
}
